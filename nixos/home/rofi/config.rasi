/**
 * Unified Rofi Configuration File
 * Feature Set: Application Launcher, Window Switcher, and File Browser
 * Theme: Catppuccin Mocha Palette Sync
 **/

configuration {
    /* Core Mode Activation */
    modi:                       "drun,window,filebrowser";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    terminal:                   "ghostty";
    
    /* Display Formatting */
    drun-display-format:        "{name}";
    window-display-format:      "{w} · {c} · {t}";
    
    /* Interface Labels */
    display-drun:               " Applications";
    display-window:             " Windows";
    display-filebrowser:        " File Browser";
    
    /* Navigation Hotkeys within Rofi Menu */
    kb-mode-next:               "Shift+Right,Control+Tab";
    kb-mode-previous:           "Shift+Left";
}

/* --- THEME VARIABLES & COLOR PALETTE (Catppuccin Mocha) --- */
* {
    bg:      #1e1e2e; /* Base: Deep Primary Background */
    bg-alt:  #181825; /* Mantle: Secondary Input Panel Background */
    fg:      #cdd6f4; /* Text: Primary Text Value */
    accent:  #b4befe; /* Lavender: Pastel Highlight Component */
    border:  #b4befe; /* Lavender: Geometric Edge Border Control */
}

/* --- SYSTEM WINDOW STRUCTURE --- */
window {
    width:            600px;
    border:           2px;
    border-radius:    12px;
    border-color:     @border;
    background-color: @bg;
    padding:          20px;
    font:             "JetBrainsMono Nerd Font 11";
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, mode-switcher, listview ];
    spacing:          15px;
}

/* --- INTERACTIVE SEARCH FIELD --- */
inputbar {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          10px 15px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Type to search...";
    placeholder-color:#585b70; /* Surface 2: Dimmed Placeholder */
}

/* --- VIEW CONTROLLER / MODE SWITCHER --- */
mode-switcher {
    background-color: transparent;
    spacing:          10px;
}

button {
    padding:          8px;
    background-color: @bg-alt;
    text-color:       #6c7086; /* Overlay 0: Unselected Mode Text */
    border-radius:    6px;
    horizontal-align: 0.5;
}

button selected {
    background-color: @accent;
    text-color:       @bg;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

/* --- DATA RENDER VIEW --- */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          5px;
    cycle:            true;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    border-radius:    6px;
    spacing:          12px;
}

/* Operational Focused Matrix Status */
element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
